"""MLIR as one shared library.

Same reasoning as //bazel/llvm-shared:LLVM, and the same two requirements --
default visibility, and every library in the closure listed. MLIR sits on top of
LLVM, so this takes libLLVM.dylib as a dynamic_dep rather than absorbing a
second copy of it.

The dep list answers

    bazel query 'kind("cc_library rule",
                      filter("llvm-project//mlir", deps(//KGEN/tools/mojo:mojo)))'

which is 468 targets.
"""

load("@rules_cc//cc:defs.bzl", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

cc_shared_library(
    name = "MLIR",
    shared_lib_name = "libMLIR.dylib",
    dynamic_deps = ["//bazel/llvm-shared:LLVM"],
    exports_filter = ["@llvm-project//mlir:__subpackages__"],
