<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded as __TEXT,__info_plist in the BARE bin/roast, so the process
     has a bundle identity (TCC prompts and AppleScript name resolution both
     read it) even when nobody has built Roast.app. The bundle's own
     Info.plist in make-app.sh is the full version; keep the identifier and
     name in step with it. -->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key> <string>org.mojococoa.roast</string>
  <key>CFBundleName</key>       <string>Roast</string>
  <key>NSAppleScriptEnabled</key><true/>
</dict>
</plist>
